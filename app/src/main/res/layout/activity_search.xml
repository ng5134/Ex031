<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/et_search_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="חפש לפי תיאור..." />

    <Spinner
        android:id="@+id/sp_search_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/et_min_price"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="מינימום"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/et_max_price"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="מקסימום"
            android:inputType="numberDecimal" />
    </LinearLayout>

    <Spinner
        android:id="@+id/sp_sort_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_execute_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="בצע חיפוש וסינון"
        android:layout_marginTop="16dp"
        android:onClick="performSearch" />

    <TextView
        android:id="@+id/tv_search_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="סך הכל תוצאות: 0"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/lv_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>